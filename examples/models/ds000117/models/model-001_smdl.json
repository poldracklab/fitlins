{
  "Name": "Basic",
  "Description": "",
  "Input": {
    "task": "facerecognition"
  },
  "Nodes": [
    {
      "Name": "run",
      "Level": "run",
      "GroupBy": [
        "run",
        "session",
        "subject"
      ],
      "Transformations": {
        "Transformer": "pybids-transforms-v1",
        "Instructions": [
          {
            "Name": "Factor",
            "Input": [
              "trial_type"
            ]
          },
          {
            "Name": "Or",
            "Input": [
              "trial_type.FAMOUS",
              "trial_type.UNFAMILIAR"
            ],
            "output": [
              "trial_type.REAL"
            ]
          },
          {
            "Name": "Convolve",
            "Input": [
              "trial_type.REAL",
              "trial_type.SCRAMBLED"
            ]
          }
        ]
      },
      "Model": {
        "X": [
          "trial_type.SCRAMBLED",
          "trial_type.REAL",
          "trans_x",
          "trans_y",
          "trans_z",
          "rot_x",
          "rot_y",
          "rot_z"
        ]
      },
      "Contrasts": [
        {
          "Name": "face_vs_scram",
          "ConditionList": [
            "trial_type.REAL",
            "trial_type.SCRAMBLED"
          ],
          "weights": [
            1,
            -1
          ],
          "type": "t"
        }
      ]
    },
    {
      "Name": "subject",
      "Level": "subject",
      "GroupBy": [
        "contrast",
        "subject"
      ],
      "Model": {
        "X": [
          1
        ],
        "Type": "glm"
      },
      "DummyContrasts": {
        "Conditions": [
          "face_vs_scram"
        ],
        "Type": "FEMA"
      }
    },
    {
      "Name": "dataset",
      "Level": "dataset",
      "GroupBy": ["contrast"],
      "Model": {
        "X": [
          1
        ],
        "Type": "glm"
      },
      "DummyContrasts": {
        "Conditions": [
          "face_vs_scram"
        ],
        "Type": "t"
      }
    }
  ]
}
